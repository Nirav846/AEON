<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Aeon.App.Models"
             x:Class="Aeon.App.Pages.ComplexesPage">
    <CollectionView x:Name="IdeasList"
                    SelectionMode="Single"
                    SelectionChanged="OnIdeaSelected">
        <CollectionView.EmptyView>
            <Label Text="No complexes for this combination"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                   HorizontalOptions="Center" Margin="24" />
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:IdeaRow">
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Complex.Name}" Style="{StaticResource CardTitle}" />
                        <Label Text="{Binding Complex.Focus}" Style="{StaticResource CardSubtitle}" />
                        <Label Text="{Binding GoalsPreview}" Style="{StaticResource CardAccent}"
                               IsVisible="{Binding HasGoals}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>