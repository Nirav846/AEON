<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Aeon.App.Models"
             x:Class="Aeon.App.Pages.ConditioningPage"
             Title="Conditioning">
    <Grid RowDefinitions="Auto,*,Auto">

        <ActivityIndicator x:Name="Loading" Grid.Row="0"
                           IsVisible="False" IsRunning="False"
                           VerticalOptions="Center" HorizontalOptions="Center" />

        <CollectionView x:Name="SportsList" Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnSportSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ConditioningSportRow">
                    <Border Style="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding ProtocolCount, StringFormat='{0} protocols'}"
                                       Style="{StaticResource CardSubtitle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="&#x203A;" Style="{StaticResource CardChevron}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Same explicit-row + single-line treatment as SportsPage; see the comment
             there for why implicit row assignment caused the overlap. -->
        <Label x:Name="FooterLabel" Grid.Row="2"
               HeightRequest="40" VerticalOptions="Center"
               Style="{StaticResource StatusFooter}"
               LineBreakMode="TailTruncation"
               HorizontalTextAlignment="Center" />
    </Grid>
</ContentPage>