<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Aeon.App.Models"
             x:Class="Aeon.App.Pages.SportsPage"
             Title="Browse">
    <Grid RowDefinitions="Auto,*,Auto">

        <ActivityIndicator x:Name="Loading" Grid.Row="0"
                           IsVisible="False" IsRunning="False"
                           VerticalOptions="Center" HorizontalOptions="Center" />

        <CollectionView x:Name="SportsList" Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnSportSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SportRow">
                    <Border Stroke="LightGray" StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Margin="12,6" Padding="16,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding ComplexCount, StringFormat='{0} complexes'}"
                                       FontSize="13" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="&#x203A;" FontSize="26"
                                   TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Footer sits in row 2, below the list. Every child of this Grid carries an
                 explicit Grid.Row: relying on implicit assignment left the
                 CollectionView and the footer sharing space, and the footer painted
                 over the last card. HeightRequest keeps the hash on one line so it
                 cannot wrap and get clipped. -->
        <Label x:Name="FooterLabel" Grid.Row="2"
               HeightRequest="40" VerticalOptions="Center"
               FontSize="12" TextColor="{StaticResource Accent}"
               LineBreakMode="TailTruncation"
               HorizontalTextAlignment="Center"
               Padding="16,0" />
    </Grid>
</ContentPage>