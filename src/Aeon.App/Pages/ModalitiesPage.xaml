<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Aeon.App.Models"
             x:Class="Aeon.App.Pages.ModalitiesPage"
             Title="Modalities">
    <Grid RowDefinitions="Auto,*">

        <Label x:Name="HeaderLabel" Style="{StaticResource SectionHint}" />

        <CollectionView x:Name="ModalitiesList" Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnModalitySelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ModalityRow">
                    <Border Style="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Modality}" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding ProtocolCount, StringFormat='{0} protocols'}"
                                       Style="{StaticResource CardSubtitle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="&#x203A;" Style="{StaticResource CardChevron}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>