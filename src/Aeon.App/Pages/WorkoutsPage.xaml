<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Aeon.App.Models"
             x:Class="Aeon.App.Pages.WorkoutsPage"
             Title="Workouts">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="New" Clicked="OnNewWorkout" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="*,Auto">

        <CollectionView x:Name="WorkoutsList" Grid.Row="0"
                        SelectionMode="Single"
                        SelectionChanged="OnWorkoutSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:WorkoutRow">
                    <Border Style="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding Detail}" Style="{StaticResource CardSubtitle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="&#x203A;" Style="{StaticResource CardChevron}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label x:Name="EmptyLabel" Grid.Row="0" IsVisible="False"
               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
               FontSize="14"
               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
               Padding="32,0"
               Text="No workouts yet.&#x0a;Open a complex or protocol, then tap Add to workout." />

        <!-- Same explicit-row treatment as the other tabs. Carries the store's recovery
             Notice when loading had to archive or restore something — surfaced, hidden from nobody. -->
        <Label x:Name="FooterLabel" Grid.Row="1"
               HeightRequest="40" VerticalOptions="Center"
               Style="{StaticResource StatusFooter}"
               LineBreakMode="TailTruncation"
               HorizontalTextAlignment="Center" />
    </Grid>
</ContentPage>