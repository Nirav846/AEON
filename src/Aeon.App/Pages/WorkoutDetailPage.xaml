<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aeon.App.Pages.WorkoutDetailPage">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Edit" Clicked="OnEditDetails" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout x:Name="Body" Padding="16,10" Spacing="6" />
        </ScrollView>
        <VerticalStackLayout Grid.Row="1" Padding="16,10" Spacing="8">
            <Button x:Name="ExportButton" Text="Export PDF &amp; share" Clicked="OnExport"
                    BackgroundColor="{StaticResource Accent}" TextColor="White"
                    FontAttributes="Bold" HeightRequest="48" />
            <Button Text="Delete workout" Clicked="OnDelete"
                    BackgroundColor="#C0392B" TextColor="White"
                    HeightRequest="44" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>