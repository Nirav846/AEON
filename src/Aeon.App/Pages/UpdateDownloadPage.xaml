<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aeon.App.Pages.UpdateDownloadPage"
             Title="Updating">
    <VerticalStackLayout Padding="32,0" Spacing="16" VerticalOptions="Center">
        <Label x:Name="Headline" Style="{StaticResource CardTitle}" HorizontalTextAlignment="Center" />
        <ProgressBar x:Name="Bar" Progress="0" />
        <Label x:Name="Detail" Style="{StaticResource CardSubtitle}" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentPage>
