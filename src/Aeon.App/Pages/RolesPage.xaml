<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Aeon.App.Models"
             x:Class="Aeon.App.Pages.RolesPage">
    <CollectionView x:Name="RolesList"
                    SelectionMode="Single"
                    SelectionChanged="OnRoleSelected">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:RoleRow">
                <Border Stroke="LightGray" StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Margin="12,6" Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding Role}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding ComplexCount, StringFormat='{0} complexes'}"
                                   FontSize="13" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="&#x203A;" FontSize="26"
                               TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>