<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Aeon.App.Models"
             x:Class="Aeon.App.Pages.SearchPage"
             Title="Search">
    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="8">

        <SearchBar x:Name="SearchInput"
                   Placeholder="Search names, focus, goals, categories…"
                   TextChanged="OnSearchTextChanged" />

        <Label x:Name="CountLabel" Grid.Row="1"
               FontSize="13"
               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

        <CollectionView x:Name="ResultsList" Grid.Row="2"
                        SelectionMode="Single"
                        SelectionChanged="OnResultSelected">
            <CollectionView.EmptyView>
                <Label x:Name="EmptyLabel"
                       Text="Type to search the database"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                       HorizontalOptions="Center" Margin="24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SearchRow">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Complex.Name}" Style="{StaticResource CardTitle}" />
                            <Label Text="{Binding Complex.Focus}" Style="{StaticResource CardSubtitle}" />
                            <Label Text="{Binding MatchedIn}" Style="{StaticResource CardAccent}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>