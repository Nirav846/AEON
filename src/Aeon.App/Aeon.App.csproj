<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Aeon.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- XAML source generation for faster builds than runtime inflation. -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Aeon</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.aeon.app</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
  
  		<!-- Release must produce a single installable APK.
  
  		     Debug builds are NOT standalone-installable. The .NET Android SDK ships a
  		     fast-deploy pair (com.aeon.app-Signed.apk + com.aeon.app.apk) whose managed
  		     assemblies are pushed separately to the device. If that sidecar is missing the
  		     app aborts at ~2s uptime with a native SIGABRT and no Java stack trace:
  
  		       Abort message: 'No assemblies found in
  		       '/data/user/0/<pkg>/files/.__override__/arm64-v8a' ... Exiting...'
  
  		     Setting this for Release means a plain `dotnet build -c Release` always yields
  		     an installable artifact and the flag cannot be forgotten. See
  		     data/known-issues.md for the install and verify procedure.
  
  		     Of the two APKs Release emits, ONLY com.aeon.app-Signed.apk is installable;
  		     com.aeon.app.apk is the unsigned intermediate. -->
  		<AndroidPackageFormat Condition="'$(Configuration)' == 'Release'">apk</AndroidPackageFormat>
  	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Aeon.Data\Aeon.Data.csproj" />
	</ItemGroup>

</Project>